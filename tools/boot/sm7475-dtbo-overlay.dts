// SPDX-License-Identifier: BSD-3-Clause
/*
 * SM7475 / Realme GT Neo5 SE (RMX3700) 专用 dtbo overlay。
 *
 * 为什么需要它：
 *   原厂 dtbo 里的 overlay 是相对原厂 base DTB 做的差分补丁——409 个
 *   fragment，target 全是 <&label>，依赖 base DTB 的 /__symbols__ 节点
 *   在启动时解析。mainline 的 DTB 是一棵独立完整的设备树，没有这些符号，
 *   bootloader 执行 fdt_overlay_apply() 会直接 FDT_ERR_NOTFOUND 失败，
 *   于是放弃启动内核、立刻回到 fastboot（即"秒回 fastboot"）。
 *
 * 因此这里提供与本机 msm-id / board-id / pmic-id 完全匹配、但内容为空的
 * overlay：bootloader 能选中并成功应用它，mainline DTB 原样交给内核，
 * 原来的叠加动作不再发生。
 */
/dts-v1/;
/plugin/;

/ {
	/* 与设备 DTB、原厂 overlay 的匹配属性保持一致，确保能被选中 */
	qcom,msm-id = <0x24f 0x10000>;
	qcom,board-id = <0x10008 0>;
	qcom,pmic-id-size = <10>;
	qcom,pmic-id = <47 0 0 0 0 0 0 0 65 65>;
	oplus,project-id = <22737 22623>;

	fragment@0 {
		/* 用 target-path 而非 target = <&label>，无需 base 的 __symbols__ */
		target-path = "/";
		__overlay__ {
			mainline-dtbo-placeholder {
				compatible = "mainline,dtbo-placeholder";
			};
		};
	};
};
