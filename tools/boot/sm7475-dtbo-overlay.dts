// SPDX-License-Identifier: BSD-3-Clause
/*
 * SM7475 / Realme GT Neo5 SE (RMX3700) 专用 dtbo overlay。
 *
 * 为什么不用自建 DTB：实测该机 bootloader 只接受「与原厂逐字节一致」的
 * vendor_boot DTB 区域，任何替换（哪怕只换其中一份 DTB）都会直接放弃引导、
 * 秒回 fastboot。所以 vendor_boot 保持原厂原样，我们只通过 dtbo overlay
 * 往原厂 base DTB 里注入内核需要的节点（这里是 simple-framebuffer）。
 *
 * 两个实测要点：
 *  1. dtbo 分区必须带 AVB footer（add_hash_footer），否则 bootloader 拒绝；
 *  2. overlay 的 fragment 必须用 target = <&symbol> 引用原厂 base DTB 的
 *     /__symbols__；实测 target-path = "/" 不被支持。
 *     原厂 base DTB 里 chosen = "/chosen"，故用 <&chosen>。
 */
/dts-v1/;
/plugin/;

/ {
	/* 与原厂 overlay 的匹配属性保持一致，确保能被选中 */
	qcom,pmic-id = <47 0 0 0 0 0 0 0 65 65>;
	qcom,pmic-id-size = <10>;
	model = "Qualcomm Technologies, Inc. Ukee MTP, Senna A";
	compatible = "qcom,ukee-mtp", "qcom,ukee", "qcom,mtp";
	qcom,msm-id = <0x24f 0x10000>;
	qcom,board-id = <0x10008 0>;
	oplus,project-id = <22737 22623>;

	/* 往原厂 /chosen 里塞入 simple-framebuffer，让 simplefb 接管开机 logo
	 * 所在的扫描缓冲，从而在内核启动早期就能在屏幕上看到 dmesg。 */
	fragment@0 {
		target = <&chosen>;
		__overlay__ {
			framebuffer@b8000000 {
				compatible = "simple-framebuffer";
				reg = <0x0 0xb8000000 0x0 0x2b00000>;
				width = <1240>;
				height = <2772>;
				stride = <4960>;
				format = "a8r8g8b8";
			};
		};
	};
};
