# Diagnostic overlay; retain panel handoff and use dynamic SSPP allocation.
# Enable with EXTRA_FRAGMENT_REL; see the display bring-up documentation.
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 loglevel=8 ignore_loglevel clk_ignore_unused regulator_ignore_unused msm.dsi_cmd_fifo=1 panel_tianma_nt37705.bootloader_handoff=1 msm.dpu_use_virtual_planes=1"
