# Diagnostic overlay; compare clocked MDSS reset, keeping panel handoff.
# The option defaults off and is limited to Ukee with the SM8450 MDSS layout.
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 loglevel=8 ignore_loglevel clk_ignore_unused regulator_ignore_unused msm.dsi_cmd_fifo=1 panel_tianma_nt37705.bootloader_handoff=1 msm.dpu_use_virtual_planes=1 msm.mdss_reset_with_clocks=1"
