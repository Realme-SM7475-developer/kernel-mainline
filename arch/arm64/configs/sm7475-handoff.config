# Diagnostic overlay for sm7475.config; preserve ABL's panel state once.
# Enable with EXTRA_FRAGMENT_REL; see the display bring-up documentation.
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 loglevel=8 ignore_loglevel clk_ignore_unused regulator_ignore_unused msm.dsi_cmd_fifo=1 panel_tianma_nt37705.bootloader_handoff=1"
