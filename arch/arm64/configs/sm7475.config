# SM7475 (Realme GT Neo5 SE) mainline bring-up fragment
#
# 说明：本文件只描述 SM7475 / Realme GT Neo5 SE 这台机器的差异配置，
# 由 tools/build-sm7475.sh 与 arch/arm64/configs/defconfig 合并使用，
# 不覆盖通用 defconfig，避免和其他机器配置混在一起。
#
# 定位：早期 bring-up / 诊断阶段。内核自带一个 console 驱动
# （drivers/soc/qcom/sm7475-splashfb.c）直接向 bootloader 的开机 logo
# 扫描缓冲渲染，屏幕即可看到 dmesg，不依赖串口和 pstore。
# 该缓冲只允许它这一个写入者：fbdev/fbcon 必须保持关闭（见下方说明）。

# ---- 平台/时钟/引脚控制器 ----
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_CAPE=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_GDSC=y
CONFIG_SM_GCC_8450=y

# ---- 控制台 / 日志：屏幕可见 ----
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
# 裸 printk（不带级别）按 KERN_INFO(6) 处理：仍然显示，但 KERN_DEBUG(7)
# 的调试输出被过滤掉。屏幕只有 86 行，调试刷屏正是「真正出问题的那几行
# 被顶掉、看不到卡在哪」的直接原因——bring-up 要的是「卡在哪」，不是全量日志。
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=6
# 1 MiB：console 在 early_initcall 注册时会回放整段 dmesg，缓冲区太小的话
# 早期的关键行会在我们注册之前就被环形覆盖掉。
CONFIG_LOG_BUF_SHIFT=20
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- 强制内核命令行 ----
# arm64 内核的 cmdline 取自 DTB /chosen/bootargs，而该字段由 bootloader 写入
# 并会被 bootconfig 覆盖：写进 boot 头的 cmdline、乃至用 dtbo 往 /chosen 注入
# 的 bootargs，都会被 ABL 覆盖掉。arm64 没有 CMDLINE_EXTEND，只能 FORCE。
# 屏幕日志由 drivers/soc/qcom/sm7475-splashfb.c 里那个 CON_ENABLED 的真实
# console 渲染，不经过 fbcon，所以这里不再需要 console=tty0（fbcon 已关闭，
# tty0 根本没有输出设备）。保留串口只为万一接了线还能用。
# 关键：**不要加 ignore_loglevel**——它会强制 KERN_DEBUG 也上屏，把真正
# 出问题的那几行顶掉；loglevel=7 保留 emerg..info、丢弃 debug。
CONFIG_CMDLINE="console=ttyMSM0,115200n8 loglevel=7 clk_ignore_unused regulator_ignore_unused"
CONFIG_CMDLINE_FORCE=y

# ---- splash 缓冲上的自制 console（必须是唯一写入者）----
# 屏幕日志由 drivers/soc/qcom/sm7475-splashfb.c 实现：它注册一个真正的
# struct console，用内核 8x16 字体把 printk 渲染到 bootloader 那块仍在被
# 扫描的 splash 显存（0xb8000000）上。这条路不经过 fbdev，也不需要 DTB 里
# 有 framebuffer 节点，所以「本机 bootloader 拒绝任何 DTB 改动」不再挡路。
CONFIG_SM7475_SPLASHFB=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y

# simplefb / fbcon 必须关闭：simplefb 一旦 probe，fbcon 就会绑上 fb0，从而
# 成为**第二个**往同一块物理像素写入的 console。两个 console 交错写一块
# 面板正在扫描的显存，正是之前屏幕出现雪花状撕裂、且日志被 fbcon 自己重绘
# 顶掉的根源。这块显存只允许一个写入者，所以这里既不建 fbdev 也不建 fbcon。
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY is not set
# CONFIG_SYSFB is not set
# CONFIG_FB_EFI is not set
# CONFIG_DRM_SIMPLEDRM is not set

# ---- 不采集 pstore 日志：日志只走屏幕 ----
# 本项目的日志通道是自制 console 直接渲染到屏幕。pstore 的 console 后端会把
# 每一行 printk 再写一份进 RAM，纯属多余开销，明确关掉；RAM 后端（arm64
# defconfig 里是 =m）也一并关掉。
# 不必（也无法）写 "CONFIG_PSTORE is not set"：arm64 defconfig 打开了
# CONFIG_ACPI_APEI，而它在 drivers/acpi/apei/Kconfig 里 select PSTORE，显式
# 关掉的 PSTORE 会被 kconfig 反过来置成 =y。剩一个空壳无害——只要没有任何
# 后端在记录，PSTORE 本体就什么都不做。
# CONFIG_PSTORE_CONSOLE is not set
# CONFIG_PSTORE_RAM is not set

# ---- 早期异常保持可见：不要一 oops 就 panic/重启 ----
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_TIMEOUT=0
# CONFIG_BOOTPARAM_HARDLOCKUP_PANIC is not set

# ---- 早期 bring-up 不接管固件管理的 watchdog ----
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# CONFIG_QCOM_WDT is not set
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set

# ---- 固定内核地址，减少早期异常/handoff 变量 ----
# CONFIG_RANDOMIZE_BASE is not set

# ---- vendor DTB 里的固件电源/IOMMU 节点暂由 bootloader 管理 ----
# CONFIG_ARM_SMMU is not set
# CONFIG_ARM_SMMU_V3 is not set
# CONFIG_QCOM_COMMAND_DB is not set
# CONFIG_QCOM_RPMH is not set
# CONFIG_QCOM_RPMHPD is not set
# CONFIG_QCOM_SMEM is not set
# CONFIG_ARM_QCOM_CPUFREQ_NVMEM is not set
# CONFIG_ARM_QCOM_CPUFREQ_HW is not set

# ---- Qualcomm GENI 串口控制台（DTS stdout-path 指向 qup7/uart7）----
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# ---- UFS 启动存储 + QMP UFS PHY ----
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# ---- USB gadget / ADB 诊断控制台 ----
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

# ---- devtmpfs：initramfs 早期挂载 ----
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
