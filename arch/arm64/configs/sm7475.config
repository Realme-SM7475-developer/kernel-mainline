# SM7475 (Realme GT Neo5 SE) mainline bring-up fragment
#
# 说明：本文件只描述 SM7475 / Realme GT Neo5 SE 这台机器的差异配置，
# 由 tools/build-sm7475.sh 与 arch/arm64/configs/defconfig 合并使用，
# 不覆盖通用 defconfig，避免和其他机器配置混在一起。
#
# 当前由 MSM DRM 的 fbdev/fbcon 提供屏幕控制台，USB ACM shell 用于诊断。
# 自制 splashfb 和 simplefb 保持关闭，避免同时写 bootloader 的扫描缓冲。

# ---- 平台/时钟/引脚控制器 ----
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_CAPE=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_GDSC=y
CONFIG_SM_GCC_8450=y

# ---- 控制台 / 日志：屏幕可见 ----
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
# 屏幕只留「警告及以上」：86 行的屏幕装不下整段开机日志，驱动探测成功那一类
# info 会不停刷屏，把真正出问题的那几行顶掉。console_loglevel=4 之后，内核在
# 调用各 console 的 .write() 之前就把低级别消息过滤掉了，我们的 splash console
# 根本收不到它们（CON_PRINTBUFFER 的整段回放同样会被过滤），所以不需要改驱动。
# 代价：正常开机时屏幕会很空；如果它是「一条告警都没有、静默卡住」，屏幕上就只
# 剩最后一条告警。想换回带进度信息的模式，把 cmdline 里的 quiet 换成 loglevel=7。
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
# 裸 printk（不带级别）按 KERN_WARNING(4) 处理：这样没标注级别的消息不会被
# quiet 静默吞掉，而显式 pr_debug/dev_dbg 的调试输出仍然上不了屏。
# 关键：不要写 ignore_loglevel，它会反过来把 KERN_DEBUG 也强制打到屏幕上。
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=4
# 1 MiB：console 在 early_initcall 注册时会回放整段 dmesg，缓冲区太小的话
# 早期的关键行会在我们注册之前就被环形覆盖掉。
CONFIG_LOG_BUF_SHIFT=20
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- 强制内核命令行 ----
# arm64 内核的 cmdline 取自 DTB /chosen/bootargs，而该字段由 bootloader 写入
# 并会被 bootconfig 覆盖：写进 boot 头的 cmdline、乃至用 dtbo 往 /chosen 注入
# 的 bootargs，都会被 ABL 覆盖掉。arm64 没有 CMDLINE_EXTEND，只能 FORCE。
# Keep oops on the console without converting it to panic; firmware watchdogs can
# otherwise reset the phone before pstore has a chance to capture the failure.
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 loglevel=8 ignore_loglevel clk_ignore_unused regulator_ignore_unused msm.dsi_cmd_fifo=1"
CONFIG_CMDLINE_FORCE=y

# ---- splash 缓冲上的自制 console（必须是唯一写入者）----
# 屏幕日志由 drivers/soc/qcom/sm7475-splashfb.c 实现：它注册一个真正的
# struct console，用内核 8x16 字体把 printk 渲染到 bootloader 那块仍在被
# 扫描的 splash 显存（0xb8000000）上。这条路不经过 fbdev，也不需要 DTB 里
# 有 framebuffer 节点，所以「本机 bootloader 拒绝任何 DTB 改动」不再挡路。
# DRM owns the panel once the MDSS pipeline is enabled.
# CONFIG_SM7475_SPLASHFB is not set
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y

# DRM 接管扫描缓冲；不启用固件 framebuffer 驱动。
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
# CONFIG_SYSFB is not set
# CONFIG_FB_EFI is not set
# CONFIG_DRM_SIMPLEDRM is not set

# ---- Mainline MDSS / DPU / DSI display ----
CONFIG_DRM=y
CONFIG_DRM_MSM=y
# Keep a kernel-owned fbdev console during bring-up.  The mainline debug
# ramdisk has no compositor, so without this the bootloader splash disappears
# as soon as DRM takes over and the panel looks dead even when modeset worked.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_DRM_PANEL_TIANMA_NT37705=y
CONFIG_SM_DISPCC_8450=y

# ---- Persist early boot logs across DRM-triggered resets ----
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# ---- 早期异常保持现场：panic 不自动重启，供拍屏/pstore 取证 ----
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_TIMEOUT=0
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set

# ---- 早期 bring-up 不接管固件管理的 watchdog ----
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# CONFIG_QCOM_WDT is not set
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set

# ---- 固定内核地址，减少早期异常/handoff 变量 ----
# CONFIG_RANDOMIZE_BASE is not set

# ---- 显示、USB 和 UFS 的 DMA 由主线 SMMU 管理 ----
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_ARM_SMMU_V3=y
# CONFIG_ARM_QCOM_CPUFREQ_NVMEM is not set
# CONFIG_ARM_QCOM_CPUFREQ_HW is not set

# ---- RPMH / SMEM / Command DB：DTS 引用到的 provider 必须存在 ----
# 这些之前是故意关掉的（当时的说法是「由 bootloader 管理」），但后果是整条链永远
# 停不下来：DTS 里 gcc 的 clocks 引用了 <&rpmhcc RPMH_CXO_CLK>，rpmhcc 不存在时
# gcc 永远 -EPROBE_DEFER，于是串口/UFS/USB/所有 gcc 消费者跟着一起 defer；而
# smem 节点（compatible = "qcom,smem"）和 cmd_db 节点（compatible = "qcom,cmd-db"）
# 对应的驱动不在，qcom_scm 找不到 SCM 内存区域，SPMI/PMIC 一整套也起不来。
# 依赖关系（已核实）：QCOM_COMMAND_DB 需 OF_RESERVED_MEM、QCOM_SMEM 需 HWSPINLOCK
# （两者本来就是 y）；QCOM_RPMHPD 需 QCOM_RPMH && QCOM_COMMAND_DB；
# QCOM_CLK_RPMH 需 QCOM_RPMH，且它才是 rpmhcc 那个 clock-controller 的驱动
# （DTS 里是 compatible = "qcom,sm8450-rpmh-clk"），不打开 gcc 照样起不来。
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM_SM8450=y
# DRM_MSM is built in for the display bring-up.  These optional Qualcomm
# providers are tristate dependencies of DRM_MSM and must match its y state.
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y

# ---- Qualcomm GENI 串口控制台（DTS stdout-path 指向 qup7/uart7）----
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# ---- UFS 启动存储 + QMP UFS PHY ----
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
# 本机 USB2 PHY 是 Synopsys **eUSB2 PHY**：原厂 compatible 是
# "qcom,usb-snps-eusb2-phy"，供电 vdd/vdda12，寄存器窗口 0x154。对应主线驱动是
# drivers/phy/phy-snps-eusb2.c（即 qcom,sm8550-snps-eusb2-phy），同一颗 SoC 的
# marble（POCO F5）主线端正是用它，且它的 DTS 与本机原厂节点逐项吻合：
# reg 0x88e3000 0x154 / vdd+vdda12 / ref=XO / GCC_QUSB2PHY_PRIM_BCR。
# femto（qcom,usb-snps-hs-7nm-phy）与 M31（sm8750 表）都实测对不上这颗硅。
CONFIG_PHY_SNPS_EUSB2=y

# ---- USB gadget / ADB 诊断控制台 ----
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

# ---- devtmpfs：initramfs 早期挂载 ----
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- 根文件系统：本机 UFS 分区用的 Android 文件系统三件套 ----
# UFS 起来之后，下一步要从这块盘上挂根文件系统。本机分区用的是 Android 的
# 标准格式，缺一样都挂不上：
#   system / vendor / product 等（在 super 逻辑分区里）→ erofs（只读、压缩）
#   userdata                                            → f2fs
#   metadata 等小分区                                    → ext4
# ext4 本来就是 y；erofs/f2fs 在 arm64 defconfig 里是关的，这里显式打开。
# erofs 的压缩支持必须开 ZIP，否则解压镜像（LZ4 / LZMA / DEFLATE / ZSTD）
# 会以「不支持压缩」报错挂不上。
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
