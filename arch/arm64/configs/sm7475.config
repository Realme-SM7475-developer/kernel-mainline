# SM7475 (Realme GT Neo5 SE) mainline bring-up fragment
#
# 说明：本文件只描述 SM7475 / Realme GT Neo5 SE 这台机器的差异配置，
# 由 tools/build-sm7475.sh 与 arch/arm64/configs/defconfig 合并使用，
# 不覆盖通用 defconfig，避免和其他机器配置混在一起。
#
# 定位：早期 bring-up / 诊断阶段。内核通过 simplefb 直接在开机 logo 的
# 扫描缓冲上输出，屏幕即可看到 dmesg 滚动，不依赖串口和 pstore。

# ---- 平台/时钟/引脚控制器 ----
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_CAPE=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_GDSC=y
CONFIG_SM_GCC_8450=y

# ---- 控制台 / 日志：屏幕可见 ----
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
CONFIG_LOG_BUF_SHIFT=19
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- 强制内核命令行（让 console=tty0 真正生效）----
# arm64 内核的 cmdline 取自 DTB /chosen/bootargs，而该字段由 bootloader 写入
# 并会被 bootconfig 覆盖：所以写进 boot 头的 cmdline、乃至用 dtbo 往
# /chosen 注入的 bootargs，都会被 ABL 覆盖掉。实测原厂 cmdline 里只有
# console=ttyMSM0（串口），没有 console=tty0 —— 于是 simplefb/fbcon 虽然
# 建起来了（开机 logo 被清空），却收不到任何内核消息，屏幕一片黑。
# arm64 没有 CMDLINE_EXTEND，只能 FORCE：忽略 bootloader 的 cmdline，
# 改用下面这段内置的，确保 console=tty0 一定生效。
CONFIG_CMDLINE="console=tty0 console=ttyMSM0,115200n8 loglevel=8 ignore_loglevel clk_ignore_unused regulator_ignore_unused initcall_blacklist=gcc_sm8450_init,cape_pinctrl_init"
CONFIG_CMDLINE_FORCE=y

# ---- simplefb：使用 bootloader 留下的线性 framebuffer ----
# 内核在 of_platform_default_populate_init 里把 /chosen 下 compatible=
# "simple-framebuffer" 的节点（由 dtbo overlay 注入）变成平台设备，再由
# fbdev 的 simplefb 驱动接管。
#
# 这里**故意不启用 SYSFB / SYSFB_SIMPLEFB / FB_EFI**：那条是 screen_info/
# EFI 的旧路径，而 sysfb_init 的 initcall 级别比 of_platform_default_populate_init
# 更早。本机 bootloader（高通 ABL 本身就是 UEFI 应用）如果顺手递了 EFI
# framebuffer 信息，sysfb 会**先**注册一个 simple-framebuffer 抢到 fb0，而 fbcon
# 只绑 fb0 —— 结果就是内核日志全进到另一个显存，面板却一直停在 bootloader 的
# logo 上，表现得「有 fb 但屏幕上什么都没有」。DT 路径根本不需要 SYSFB，关掉它
# 同时也让 FB_EFI 失效（include/linux/sysfb.h 里为 !CONFIG_SYSFB 提供了 stub，
# drivers/of/platform.c 调用的 sysfb_disable() 会退化成空函数，编译不受影响）。
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
# 由 C 代码直接注册 "simple-framebuffer" 平台设备（见 drivers/soc/qcom/
# sm7475-splashfb.c），把内核指到 bootloader 那块仍在被扫描的 splash 显存上。
# 必须这样做：本机 bootloader 不让任何 DTB 改动生效，DT 里注入 fb 节点的路
# 走不通，只能由内核自己把这个平台设备造出来。
CONFIG_SM7475_SPLASHFB=y
# CONFIG_SYSFB is not set
# CONFIG_FB_EFI is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
# 关掉 primary 检测：arm64 的 video_is_primary_device() 恒为 false（asm-generic
# 的兜底实现就是 return false，arm64 没有覆盖），开着只会引入不确定性；
# Kconfig 默认值本来就是 n。
# CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY is not set
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
# CONFIG_DRM_SIMPLEDRM is not set

# ---- 崩溃日志（可选，便于无串口时取证）----
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240

# ---- 早期异常保持可见：不要一 oops 就 panic/重启 ----
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_TIMEOUT=0
# CONFIG_BOOTPARAM_HARDLOCKUP_PANIC is not set

# ---- 早期 bring-up 不接管固件管理的 watchdog ----
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# CONFIG_QCOM_WDT is not set
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set

# ---- 固定内核地址，减少早期异常/handoff 变量 ----
# CONFIG_RANDOMIZE_BASE is not set

# ---- vendor DTB 里的固件电源/IOMMU 节点暂由 bootloader 管理 ----
# CONFIG_ARM_SMMU is not set
# CONFIG_ARM_SMMU_V3 is not set
# CONFIG_QCOM_COMMAND_DB is not set
# CONFIG_QCOM_RPMH is not set
# CONFIG_QCOM_RPMHPD is not set
# CONFIG_QCOM_SMEM is not set
# CONFIG_ARM_QCOM_CPUFREQ_NVMEM is not set
# CONFIG_ARM_QCOM_CPUFREQ_HW is not set

# ---- Qualcomm GENI 串口控制台（DTS stdout-path 指向 qup7/uart7）----
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# ---- UFS 启动存储 + QMP UFS PHY ----
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# ---- USB gadget / ADB 诊断控制台 ----
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

# ---- devtmpfs：initramfs 早期挂载 ----
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
