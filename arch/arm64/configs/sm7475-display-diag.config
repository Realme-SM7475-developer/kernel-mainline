# Temporary bring-up configuration: show early printk output on bootloader fb.
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_FONTS=y
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 fbcon=font:TER16x32 loglevel=8 ignore_loglevel oops=panic clk_ignore_unused regulator_ignore_unused"
CONFIG_FONT_TER16x32=y
