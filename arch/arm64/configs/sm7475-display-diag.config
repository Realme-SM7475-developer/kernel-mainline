# Temporary bring-up configuration: show early printk output on bootloader fb.
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# Once MSM removes the bootloader framebuffer aperture, the DRM fbdev client
# must provide a modeset and a framebuffer console of its own.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_LOG=y
# Prefer the DRM logger for this panel bring-up image so kernel output remains
# visible after MSM removes the bootloader framebuffer.
# CONFIG_DRM_CLIENT_DEFAULT_FBDEV is not set
CONFIG_DRM_CLIENT_DEFAULT_LOG=y
CONFIG_FONTS=y
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 fbcon=font:TER16x32 loglevel=8 ignore_loglevel oops=panic clk_ignore_unused regulator_ignore_unused"
CONFIG_FONT_TER16x32=y
