/dts-v1/;

#include "sm7475.dtsi"
#include <dt-bindings/gpio/gpio.h>
/* Labels the bootloader needs to merge the factory dtbo overlays; see the file. */
#include "sm7475-realme-gt-neo5-se-abl-labels.dtsi"
/* Top-level nodes the stock base has and the bootloader may fix up; see the file. */
#include "sm7475-realme-gt-neo5-se-stock-nodes.dtsi"
/* Batch 1 of the /soc migration (SPMI/PMIC subsystem); see the file. */
#include "sm7475-realme-gt-neo5-se-soc-spmi.dtsi"
/* The UFS host and PHY; see the file. */
#include "sm7475-realme-gt-neo5-se-ufs.dtsi"
/* USB2 (DWC3 + HS PHY) for the gadget debug console; see the file. */
#include "sm7475-realme-gt-neo5-se-usb.dtsi"

/ {
	model = "realme GT Neo5 SE";
	/* "qcom,ukee" is what the stock base declares, and what the bootloader
	 * itself writes into the tree it hands the kernel.  Keep our own strings
	 * first, then add the platform ones, so base selection cannot skip us for
	 * carrying only an unknown board string. */
	compatible = "realme,gt-neo5-se", "qcom,sm7475",
		     "qcom,ukee-mtp", "qcom,ukee", "qcom,mtp";
	chassis-type = "handset";
	qcom,msm-id = <0x24f 0x10000>;
	/* The stock base declares <0 0> - an "any board" wildcard - and carries no
	 * pmic-id at all; pmic-id belongs on the dtbo entry, not on the base.
	 * Writing a specific board-id / pmic-id here makes base selection stricter
	 * than the stock image and can get our slot skipped. */
	qcom,board-id = <0 0>;

	/* Safe first-bank fallback from the installed device's RAM map.
	 * The bootloader may replace this with the full installed RAM banks.
	 */
	memory {
		reg = <0 0x80000000 0 0x6a000000>;
	};

	/* The factory dtbo extends /aliases, so it needs the stock label. */
	aliases: aliases {
		serial0 = &uart7;
	};

	/* The stock base's /chosen carries only a bootargs string and
	 * stdout-path; the bootloader adds kaslr-seed / linux,initrd-start /
	 * linux,initrd-end itself on every boot even though the stock blob has no
	 * spare room for them, so pre-creating them here is not needed.  The
	 * splash console driver registers the panel scanout buffer directly
	 * (see drivers/soc/qcom/sm7475-splashfb.c) and needs no framebuffer node.
	 */
	chosen: chosen {
		bootargs = "console=ttyMSM0,115200n8 console=tty0 quiet oops=panic clk_ignore_unused regulator_ignore_unused";
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Rails the factory dtbo consumes but this tree cannot drive yet.
	 *
	 * The dtbo's camera LDOs (fragment@82: gpio-regulator@0/@1) take their
	 * vin-supply from S12B (pm8350 S12) and BOB (pm8350c BOB), and its
	 * wcd938x codec takes cdc-vdd-mic-bias-supply from BOB.  Those labels
	 * used to sit on empty sink nodes in sm7475-realme-gt-neo5-se-abl-
	 * labels.dtsi, so the supplies resolved to a node with no driver and
	 * both LDOs sat in deferred probe forever:
	 *
	 *   deferred probe pending: platform: wait for supplier
	 *                           /abl_overlay_sink/abl-sym-1
	 *
	 * The dtbo only *consumes* these labels (it never merges content into
	 * them), so - exactly as with the UFS rails - they move onto real nodes
	 * here.  The rails are PMIC/RPMH regulators the bootloader leaves
	 * enabled (it boots from a rail-controlled UFS), so until the PMIC is
	 * described they are modelled as fixed always-on.
	 *
	 * reg-fixed-voltage rejects a node with min != max outright
	 * ("Fixed regulator specified with variable voltages", -EINVAL), so each
	 * rail gets a single level rather than the stock node's supported
	 * window: S12B takes the stock node's own qcom,init-voltage (0x132a40),
	 * BOB the bottom of its window because the stock node carries no plain
	 * init value for it.  The real level stays whatever the PMIC has it set
	 * to; the drivers only read it and enable the supply.
	 */
	BOB: regulator-bob {
		compatible = "regulator-fixed";
		regulator-name = "pm8350c_bob";
		regulator-min-microvolt = <3008000>;
		regulator-max-microvolt = <3008000>;
		regulator-always-on;
		regulator-boot-on;
	};

	S12B: regulator-s12b {
		compatible = "regulator-fixed";
		regulator-name = "pm8350_s12";
		regulator-min-microvolt = <1256000>;
		regulator-max-microvolt = <1256000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* The DSI PHY is powered from PM8350 L5 (stock init voltage: 880 mV). */
	display_phy_vdds: regulator-display-phy-vdds {
		compatible = "regulator-fixed";
		regulator-name = "display_phy_vdds";
		regulator-min-microvolt = <880000>;
		regulator-max-microvolt = <880000>;
		regulator-boot-on;
	};

	/* Panel rails are presently fixed because the PMIC regulator map is not
	 * exposed by the mainline board description yet. */
	display_vddio: regulator-display-vddio {
		compatible = "regulator-fixed";
		regulator-name = "display_vddio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
	};

	display_extvdd: regulator-display-extvdd {
		compatible = "regulator-fixed";
		regulator-name = "display_extvdd";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-boot-on;
	};

	display_vci: regulator-display-vci {
		compatible = "regulator-fixed";
		regulator-name = "display_vci";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-boot-on;
	};
};

&mdss {
	status = "okay";
};

&mdss_mdp {
	status = "okay";
};

&mdss_dsi0 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&display_dsi_active>;
	pinctrl-1 = <&display_dsi_suspend>;
	status = "okay";

	panel@0 {
		compatible = "realme,gt-neo5-se-nt37705";
		reg = <0>;
		reset-gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
		vddio-supply = <&display_vddio>;
		extvdd-supply = <&display_extvdd>;
		vci-supply = <&display_vci>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				panel_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	vdds-supply = <&display_phy_vdds>;
	status = "okay";
};

&mdss_dsi1 {
	status = "disabled";
};

&mdss_dsi1_phy {
	status = "disabled";
};
&qupv3_0 {
	status = "okay";
};

&uart7 {
	compatible = "qcom,geni-debug-uart", "qcom,msm-geni-console";
	pinctrl-0 = <&uart7_default>;
	pinctrl-1 = <&uart7_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

&tlmm {
	uart7_default: uart7-default-state {
		pins = "gpio26", "gpio27";
		function = "qup7";
		drive-strength = <2>;
		bias-disable;
	};

	uart7_sleep: uart7-sleep-state {
		pins = "gpio26", "gpio27";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	display_dsi_active: display-dsi-active-state {
		pins = "gpio3";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	display_dsi_suspend: display-dsi-suspend-state {
		pins = "gpio3";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
};
