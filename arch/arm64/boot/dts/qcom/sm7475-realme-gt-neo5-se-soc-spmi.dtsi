/*
 * GENERATED - do not edit by hand.
 *
 * Batch 1 of the /soc migration: the SPMI/PMIC subsystem copied out of
 * the stock base DTB (vendor_boot slot msm-id 0x24f).  Regenerate with
 * tools/boot/gen-soc-spmi.py.
 *
 * The stock base carries two qcom,spmi-pmic-arb nodes (0xc42d000 bus-id 0
 * and 0xc432000 bus-id 1) that both register the same bus and map the same
 * 0xc400000 "core" window; that produced -EEXIST for 0-0 and -EBUSY on
 * 0xc400000.  Only the bus the stock /__symbols__ calls `spmi_bus` and the
 * factory dtbo overlays extend survives.  Raw phandle numbers were
 * rewritten into label references; reg cells were expanded from the stock
 * tree's 1/1 addressing to this tree's 2/2 /soc addressing.  A node the
 * factory dtbo names (`spmi_bus`, `battery_charger`, `ucsi`) keeps that
 * label so the bootloader's merge lands in this node and not in a sink;
 * the rest get m_-prefixed labels.
 */

&soc {
	spmi_bus: qcom,spmi@c42d000 {
		compatible = "qcom,spmi-pmic-arb";
		reg = <0x0 0xc42d000 0x0 0x4000 0x0 0xc400000 0x0 0x3000 0x0 0xc500000 0x0 0x400000 0x0 0xc440000 0x0 0x80000 0x0 0xc4c0000 0x0 0x10000>;
		reg-names = "cnfg\0core\0chnls\0obsrvr\0intr";
		interrupts-extended = <&pdc 0x01 0x04>;
		interrupt-names = "periph_irq";
		interrupt-controller;
		#interrupt-cells = <0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x00>;
		cell-index = <0x00>;
		qcom,channel = <0x00>;
		qcom,ee = <0x00>;
		qcom,bus-id = <0x00>;
	};
	m_qcom_spmi_debug_10b14000: qcom,spmi-debug@10b14000 {
		compatible = "qcom,spmi-pmic-arb-debug";
		reg = <0x0 0x10b14000 0x0 0x60 0x0 0x221c8784 0x0 0x04>;
		reg-names = "core\0fuse";
		clock-names = "core_clk";
		qcom,fuse-enable-bit = <0x12>;
		#address-cells = <0x02>;
		#size-cells = <0x00>;
		depends-on-supply = <&spmi_bus>;
		depends-on2-supply = <&m_qcom_smb1394_debug_9>;
		qcom,pmk8350-debug@0 {
			compatible = "qcom,spmi-pmic";
			reg = <0x00 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
		};
		qcom,pm8350-debug@1 {
			compatible = "qcom,spmi-pmic";
			reg = <0x01 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
		};
		qcom,pm8350c-debug@2 {
			compatible = "qcom,spmi-pmic";
			reg = <0x02 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
		};
		qcom,pm8350b-debug@3 {
			compatible = "qcom,spmi-pmic";
			reg = <0x03 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
		};
		qcom,pmr735a-debug@4 {
			compatible = "qcom,spmi-pmic";
			reg = <0x04 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
		};
		qcom,pmr735b-debug@5 {
			compatible = "qcom,spmi-pmic";
			reg = <0x05 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
		};
		qcom,pm8450-debug@7 {
			compatible = "qcom,spmi-pmic";
			reg = <0x07 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
		};
		qcom,pm8010-debug@8 {
			compatible = "qcom,spmi-pmic";
			reg = <0x08 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
		};
		qcom,pm8010-debug@9 {
			compatible = "qcom,spmi-pmic";
			reg = <0x09 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			qcom,can-sleep;
