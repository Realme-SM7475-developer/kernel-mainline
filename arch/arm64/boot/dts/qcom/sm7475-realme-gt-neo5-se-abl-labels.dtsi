		wlan: abl-shim-1282 { };
		wsa2_macro: abl-shim-1283 { };
		wsa_cdc_dma_0_rx: abl-shim-1284 { };
		wsa_cdc_dma_0_tx: abl-shim-1285 { };
		wsa_cdc_dma_1_rx: abl-shim-1286 { };
		wsa_cdc_dma_1_tx: abl-shim-1287 { };
		wsa_cdc_dma_2_tx: abl-shim-1288 { };
		wsa_macro: abl-shim-1289 { };
		xbl_dtlog_mem: abl-shim-1290 { };
		xbl_ramdump_mem: abl-shim-1291 { };
		xbl_sc_mem: abl-shim-1292 { };
	};

	/* The stock base labels these three CPUs; the factory dtbo extends them. */
	cpus {
		CPU0: cpu@0 { };
		CPU4: cpu@400 { };
		CPU7: cpu@700 { };
	};

	firmware: firmware { };
};
