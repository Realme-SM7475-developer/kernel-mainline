/*
 * Bootloader label plumbing for the factory dtbo.
 *
 * The bootloader resolves every factory dtbo fragment - both its merge target
 * and every external reference inside it - by looking the label up in this
 * DTB's /__symbols__.  A missing label aborts the merge and the phone returns
 * to fastboot before the kernel runs, so all 129 labels the factory dtbo names
 * have to exist somewhere in this tree.
 *
 * A label is attached to the real node whenever the board tree describes the
 * same node, so the merged vendor content lands where it was written and the
 * values it carries point at the node the stock tree points them at:
 *
 *   soc, tlmm, apps_rsc, reserved_memory   sm7475.dtsi
 *   ramoops_mem, video_mem, adsp_mem       sm7475.dtsi (/reserved-memory regions)
 *   aliases                                sm7475-realme-gt-neo5-se.dts
 *   spmi_bus, battery_charger, ucsi        sm7475-realme-gt-neo5-se-soc-spmi.dtsi
 *   ufshc_mem, ufsphy_mem                  sm7475-realme-gt-neo5-se-soc-spmi.dtsi
 *   firmware, CPU0, CPU4, CPU7             re-declared below
 *
 * Only the labels with no real node left get an empty node inside the isolated
 * abl_overlay_sink container: that keeps the merge resolvable without letting
 * vendor content into unrelated nodes.  As subsystems are migrated out of the
 * stock base, their labels move out of this container and onto the real node.
 */

/ {
	abl_overlay_sink {
		APC1_pause: abl-sym-0 { };
		BOB: abl-sym-1 { };
		L10C: abl-sym-5 { };
		L12C: abl-sym-6 { };
		L13C: abl-sym-7 { };
		L1D: abl-sym-8 { };
		L2B: abl-sym-9 { };
		L2C: abl-sym-10 { };
		L3C: abl-sym-11 { };
		L4H: abl-sym-12 { };
		L5B: abl-sym-13 { };
		L6C: abl-sym-14 { };
		L7B: abl-sym-15 { };
		L9B: abl-sym-16 { };
		L9C: abl-sym-17 { };
		S10B: abl-sym-18 { };
		S12B: abl-sym-19 { };
		adsp_loader: abl-sym-20 { };
		apps_smmu: abl-sym-24 { };
		audio_gpr: abl-sym-25 { };
		cam_cc_titan_top_gdsc: abl-sym-27 { };
		cam_cci0: abl-sym-28 { };
		cam_cci1: abl-sym-29 { };
		cam_sensor_active_rst1: abl-sym-30 { };
		cam_sensor_active_rst3: abl-sym-31 { };
		cam_sensor_active_rst5: abl-sym-32 { };
		cam_sensor_suspend_rst1: abl-sym-33 { };
		cam_sensor_suspend_rst3: abl-sym-34 { };
		cam_sensor_suspend_rst5: abl-sym-35 { };
		cdsp_sw: abl-sym-36 { };
		clock_camcc: abl-sym-37 { };
		clock_dispcc: abl-sym-38 { };
		cpu5_hotplug: abl-sym-39 { };
		cpu5_pause: abl-sym-40 { };
		cpu6_hotplug: abl-sym-41 { };
		cpu7_hotplug: abl-sym-42 { };
		cpu_6_7_pause: abl-sym-43 { };
		dai_mi2s2: abl-sym-44 { };
		display_fps: abl-sym-45 { };
		eusb2_phy0: abl-sym-46 { };
		fsa4480: abl-sym-48 { };
		gcc_ufs_phy_gdsc: abl-sym-49 { };
		i2c_freq_100Khz_cci0: abl-sym-50 { };
		i2c_freq_1Mhz_cci0: abl-sym-51 { };
		i2c_freq_1Mhz_cci1: abl-sym-52 { };
		i2c_freq_400Khz_cci0: abl-sym-53 { };
		i2c_freq_400Khz_cci1: abl-sym-54 { };
		lpass_audio_hw_vote: abl-sym-55 { };
		lpass_cdc: abl-sym-56 { };
		lpass_core_hw_vote: abl-sym-57 { };
		lpi_tlmm: abl-sym-58 { };
		mdss_dsi0: abl-sym-59 { };
		mdss_dsi1: abl-sym-60 { };
		mdss_dsi_phy0: abl-sym-61 { };
		mdss_dsi_phy1: abl-sym-62 { };
		mdss_mdp: abl-sym-63 { };
		modem_lte_dsc: abl-sym-64 { };
		modem_nr_dsc: abl-sym-65 { };
		modem_nr_scg_dsc: abl-sym-66 { };
		msm_gpu: abl-sym-67 { };
		nfc_enable_active: abl-sym-68 { };
		nfc_enable_suspend: abl-sym-69 { };
		nfc_int_active: abl-sym-70 { };
		nfc_int_suspend: abl-sym-71 { };
		qupv3_se0_i2c: abl-sym-72 { };
		qupv3_se0_i2c_active: abl-sym-73 { };
		qupv3_se0_i2c_pins: abl-sym-74 { };
		qupv3_se0_i2c_sleep: abl-sym-75 { };
		qupv3_se13_i2c: abl-sym-76 { };
		qupv3_se14_i2c: abl-sym-77 { };
		qupv3_se18_spi: abl-sym-78 { };
		qupv3_se19_spi: abl-sym-79 { };
		qupv3_se1_i2c: abl-sym-80 { };
		qupv3_se4_i2c: abl-sym-81 { };
		qupv3_se4_spi: abl-sym-82 { };
		qupv3_se5_i2c: abl-sym-83 { };
		qupv3_se9_i2c: abl-sym-84 { };
		sdc2_off: abl-sym-87 { };
		sdc2_on: abl-sym-88 { };
		sde_dp: abl-sym-89 { };
		sde_rscc: abl-sym-90 { };
		sdhc_2: abl-sym-91 { };
		smmu_sde_sec: abl-sym-92 { };
		smmu_sde_unsec: abl-sym-93 { };
		spf_core_platform: abl-sym-95 { };
		spkr2_1_sd_n_active: abl-sym-96 { };
		spkr2_1_sd_n_sleep: abl-sym-97 { };
		spkr2_2_sd_n_active: abl-sym-98 { };
		spkr2_2_sd_n_sleep: abl-sym-99 { };
		spkr_1_sd_n_active: abl-sym-100 { };
		spkr_1_sd_n_sleep: abl-sym-101 { };
		spkr_2_sd_n_active: abl-sym-102 { };
		spkr_2_sd_n_sleep: abl-sym-103 { };
		stub_codec: abl-sym-105 { };
		tert_mi2s_sck_active: abl-sym-106 { };
		tert_mi2s_sck_sleep: abl-sym-107 { };
		tert_mi2s_sd0_active: abl-sym-108 { };
		tert_mi2s_sd0_sleep: abl-sym-109 { };
		tert_mi2s_sd1_active: abl-sym-110 { };
		tert_mi2s_sd1_sleep: abl-sym-111 { };
		tert_mi2s_ws_active: abl-sym-112 { };
		tert_mi2s_ws_sleep: abl-sym-113 { };
		thermal_zones: abl-sym-114 { };
		ts_active: abl-sym-116 { };
		ts_int_suspend: abl-sym-117 { };
		ts_release: abl-sym-118 { };
		ts_reset_suspend: abl-sym-119 { };
		usb0: abl-sym-123 { };
		usb3phy_portselect_default: abl-sym-124 { };
		va_cdc_dma_0_tx: abl-sym-125 { };
		wcd938x_reset_active: abl-sym-127 { };
		wcd938x_reset_sleep: abl-sym-128 { };
	};

	/* The stock base labels these three CPUs; the factory dtbo extends them. */
	cpus {
		CPU0: cpu@0 { };
		CPU4: cpu@400 { };
		CPU7: cpu@700 { };
	};

	firmware: firmware { };
};
